{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeadroomContextGuardContract",
  "description": "Headroom 缓存守卫与压缩真实交互契约 (Zero Hallucination Version)",
  "type": "object",
  "required": [
    "request_id",
    "cache_boundary",
    "live_zone_transforms",
    "ccr_vault_receipt"
  ],
  "properties": {
    "request_id": { "type": "string", "pattern": "^req-[a-f0-9]{8,16}$" },
    "cache_boundary": {
      "type": "object",
      "required": ["frozen_message_count"],
      "properties": {
        "frozen_message_count": { "type": "integer", "minimum": 0 }
      }
    },
    "live_zone_transforms": {
      "type": "object",
      "required": ["crushers_applied"],
      "properties": {
        "crushers_applied": {
          "type": "array",
          "items": { "type": "string", "enum": ["SmartCrusher"] }
        }
      }
    },
    "ccr_vault_receipt": {
      "type": "object",
      "required": ["chunk_ids"],
      "properties": {
        "chunk_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ccr_[a-f0-9]{16}$" }
        }
      }
    }
  }
}
